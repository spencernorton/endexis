  {
    "id": "mar_bcma_medication_administration",
    "name": "Medication Administration Record (MAR) & Barcode Medication Administration (BCMA)",
    "keywords": [
      "mar",
      "bcma",
      "medication administration",
      "med admin",
      "barcode",
      "dose given",
      "missed dose",
      "late dose",
      "infusion",
      "iv drip",
      "med_admin_event",
      "ce_med_result"
    ],
    "definition_tables": [
      {
        "table": "ORDER_CATALOG",
        "key_columns": [
          "CATALOG_CD",
          "PRIMARY_MNEMONIC"
        ],
        "role": "Medication catalog item (Code Set 200, Catalog Type = PHARMACY in Code Set 6000)"
      }
    ],
    "activity_tables": [
      {
        "table": "MED_ADMIN_EVENT",
        "key_columns": [
          "MED_ADMIN_EVENT_ID",
          "EVENT_ID",
          "ORDER_ID",
          "EVENT_TYPE_CD",
          "BEG_DT_TM",
          "SCHEDULED_DT_TM",
          "POSITIVE_PATIENT_IDENT_IND",
          "POSITIVE_MED_IDENT_IND",
          "PRSNL_ID",
          "NURSE_UNIT_CD"
        ],
        "role": "BCMA administration audit log (scan indicators, scheduled vs performed time, event type in CS 4002)"
      },
      {
        "table": "CE_MED_RESULT",
        "key_columns": [
          "EVENT_ID",
          "ADMIN_DOSAGE",
          "DOSAGE_UNIT_CD",
          "ADMIN_ROUTE_CD",
          "ADMIN_SITE_CD",
          "INFUSION_RATE",
          "INFUSION_UNIT_CD",
          "IV_EVENT_CD"
        ],
        "role": "Medication dose, route, site, and IV rate payload linked to CLINICAL_EVENT.EVENT_ID"
      }
    ],
    "payload_columns": [
      {
        "table_column": "CE_MED_RESULT.ADMIN_DOSAGE",
        "ccl_type": "f8",
        "when_used": "Numeric medication dose administered"
      },
      {
        "table_column": "CE_MED_RESULT.DOSAGE_UNIT_CD",
        "ccl_type": "f8 (CS 54)",
        "when_used": "Dose unit (mg, mcg, mL, units)"
      },
      {
        "table_column": "CE_MED_RESULT.ADMIN_ROUTE_CD",
        "ccl_type": "f8 (CS 4001)",
        "when_used": "Route of administration (PO, IV, IM, SubQ)"
      },
      {
        "table_column": "MED_ADMIN_EVENT.POSITIVE_PATIENT_IDENT_IND",
        "ccl_type": "i4",
        "when_used": "1 = Patient wristband barcode scanned"
      },
      {
        "table_column": "MED_ADMIN_EVENT.POSITIVE_MED_IDENT_IND",
        "ccl_type": "i4",
        "when_used": "1 = Medication barcode scanned"
      }
    ],
    "join_pattern_sql": "ENCOUNTER e -> ORDERS o (on o.encntr_id = e.encntr_id) -> MED_ADMIN_EVENT mae (on mae.order_id = o.order_id) -> CLINICAL_EVENT ce (on ce.event_id = mae.event_id and ce.valid_until_dt_tm >= 31-DEC-2100) -> CE_MED_RESULT cmr (on cmr.event_id = ce.event_id and cmr.valid_until_dt_tm >= 31-DEC-2100)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Medication Administration / Clinical Events",
      "fields": [
        "Enc Id",
        "Med Adm Event Id",
        "Med Adm Dt/Tm",
        "Med Adm MedScan Ind",
        "Med Adm PtScan Ind",
        "CE Med Admin Dosage",
        "CE Med Dosage Unit"
      ],
      "mandatory_filters": [
        "CE Valid Until Dt/Tm >= 12/31/2100 00:00:00",
        "CE Result Status in (Auth (Verified), Modified)"
      ]
    }
  },
