[
  {
    "id": "powerforms_assessments",
    "name": "PowerForms & Discrete Clinical Assessments (IRF-PAI, FIM, CARE, Nursing Admission, Screenings)",
    "keywords": [
      "powerform",
      "form",
      "assessment",
      "screening",
      "fim",
      "care tool",
      "irf-pai",
      "nursing history",
      "fall risk",
      "braden",
      "phq-9",
      "ciwa",
      "dcp_forms"
    ],
    "definition_tables": [
      {
        "table": "DCP_FORMS_REF",
        "key_columns": [
          "DCP_FORMS_REF_ID",
          "DESCRIPTION",
          "DEFINITION",
          "EVENT_SET_NAME"
        ],
        "role": "Master catalog of PowerForm definitions"
      },
      {
        "table": "DCP_FORMS_DEF",
        "key_columns": [
          "DCP_FORMS_DEF_ID",
          "DCP_FORMS_REF_ID",
          "DCP_SECTION_REF_ID",
          "SECTION_SEQ"
        ],
        "role": "Bridges a PowerForm to its ordered sections"
      },
      {
        "table": "DCP_SECTION_REF",
        "key_columns": [
          "DCP_SECTION_REF_ID",
          "DESCRIPTION",
          "DEFINITION"
        ],
        "role": "Section header definition within a PowerForm"
      },
      {
        "table": "DCP_INPUT_REF",
        "key_columns": [
          "DCP_INPUT_REF_ID",
          "DCP_SECTION_REF_ID",
          "INPUT_TYPE",
          "MERGE_NAME",
          "MERGE_UID"
        ],
        "role": "Individual control/prompt on a PowerForm section; MERGE_UID links to DISCRETE_TASK_ASSAY.TASK_ASSAY_CD"
      },
      {
        "table": "DISCRETE_TASK_ASSAY",
        "key_columns": [
          "TASK_ASSAY_CD",
          "MNEMONIC",
          "DESCRIPTION",
          "EVENT_CD",
          "DEFAULT_RESULT_TYPE_CD"
        ],
        "role": "Discrete Task Assay (DTA, Code Set 14003) mapped 1-to-1 to CLINICAL_EVENT.EVENT_CD (Code Set 72)"
      }
    ],
    "activity_tables": [
      {
        "table": "DCP_FORMS_ACTIVITY",
        "key_columns": [
          "DCP_FORMS_ACTIVITY_ID",
          "DCP_FORMS_REF_ID",
          "ENCNTR_ID",
          "PERSON_ID",
          "FORM_DT_TM",
          "FORM_STATUS_CD",
          "LAST_ACTIVITY_DT_TM"
        ],
        "role": "One row per charted PowerForm instance on an encounter"
      },
      {
        "table": "DCP_FORMS_ACTIVITY_COMP",
        "key_columns": [
          "DCP_FORMS_ACTIVITY_COMP_ID",
          "DCP_FORMS_ACTIVITY_ID",
          "PARENT_ENTITY_NAME",
          "PARENT_ENTITY_ID",
          "COMPONENT_CD"
        ],
        "role": "Links DCP_FORMS_ACTIVITY to the root CLINICAL_EVENT row (where PARENT_ENTITY_NAME='CLINICAL_EVENT', PARENT_ENTITY_ID=EVENT_ID, and COMPONENT_CD [CS 18189] = 'PRIMARY EVENT ID')"
      }
    ],
    "payload_columns": [
      {
        "table_column": "CLINICAL_EVENT.RESULT_VAL",
        "ccl_type": "vc",
        "when_used": "Numeric scores, short text answers, and calculated totals (EVENT_CLASS_CD in {NUM, TXT, COUNT}, Code Set 53)"
      },
      {
        "table_column": "CE_CODED_RESULT.NOMENCLATURE_ID -> NOMENCLATURE.SOURCE_STRING",
        "ccl_type": "f8 -> vc",
        "when_used": "Multi-select checkboxes, radio buttons, and alpha nomenclature responses on a PowerForm"
      },
      {
        "table_column": "CE_DATE_RESULT.RESULT_DT_TM",
        "ccl_type": "dq8",
        "when_used": "Date/time picker controls inside a PowerForm"
      },
      {
        "table_column": "CE_STRING_RESULT.STRING_RESULT_TEXT",
        "ccl_type": "vc",
        "when_used": "Long free-text comment controls inside a PowerForm"
      }
    ],
    "join_pattern_sql": "DCP_FORMS_REF dfr -> DCP_FORMS_ACTIVITY dfa (on dfr.dcp_forms_ref_id = dfa.dcp_forms_ref_id) -> DCP_FORMS_ACTIVITY_COMP dfac (on dfa.dcp_forms_activity_id = dfac.dcp_forms_activity_id and dfac.parent_entity_name = 'CLINICAL_EVENT') -> CLINICAL_EVENT ce_root (on ce_root.event_id = dfac.parent_entity_id and ce_root.valid_until_dt_tm >= 31-DEC-2100) -> CLINICAL_EVENT ce_sec (on ce_sec.parent_event_id = ce_root.event_id and ce_sec.valid_until_dt_tm >= 31-DEC-2100) -> CLINICAL_EVENT ce_fld (on ce_fld.parent_event_id = ce_sec.event_id and ce_fld.valid_until_dt_tm >= 31-DEC-2100)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Clinical Events",
      "fields": [
        "Enc Id",
        "CE Event Id",
        "CE Event",
        "CE Result Value",
        "CE Result Units",
        "CE Event End Dt Tm",
        "CE Performed Prsnl Name",
        "CE Result Status",
        "CE Valid Until Dt/Tm"
      ],
      "mandatory_filters": [
        "CE Valid Until Dt/Tm >= 12/31/2100 00:00:00",
        "CE Result Status in (Auth (Verified), Modified, Altered)"
      ]
    }
  },
  {
    "id": "interactive_view_flowsheets",
    "name": "InteractiveView (IView) Flowsheets, Vital Signs, Lines/Drains/Airways & Therapy Minutes",
    "keywords": [
      "iview",
      "interactive view",
      "flowsheet",
      "vital signs",
      "vitals",
      "blood pressure",
      "heart rate",
      "temperature",
      "spo2",
      "pain score",
      "dynamic group",
      "wound",
      "line",
      "drain",
      "therapy minutes"
    ],
    "definition_tables": [
      {
        "table": "WORKING_VIEW",
        "key_columns": [
          "WORKING_VIEW_ID",
          "DISPLAY_NAME",
          "POSITION_CD",
          "LOCATION_CD"
        ],
        "role": "Defines the IView navigator bands visible for a clinical role/location"
      },
      {
        "table": "WORKING_VIEW_SECTION",
        "key_columns": [
          "WORKING_VIEW_SECTION_ID",
          "WORKING_VIEW_ID",
          "EVENT_SET_NAME",
          "DISPLAY_NAME"
        ],
        "role": "Sections within an IView band"
      },
      {
        "table": "WORKING_VIEW_ITEM",
        "key_columns": [
          "WORKING_VIEW_ITEM_ID",
          "WORKING_VIEW_SECTION_ID",
          "PRIMITIVE_EVENT_SET_NAME"
        ],
        "role": "Individual flowsheet rows linked to V500_EVENT_SET_CODE / V500_EVENT_CODE (Code Set 72)"
      }
    ],
    "activity_tables": [
      {
        "table": "CLINICAL_EVENT",
        "key_columns": [
          "CLINICAL_EVENT_ID",
          "EVENT_ID",
          "ENCNTR_ID",
          "PERSON_ID",
          "EVENT_CD",
          "EVENT_END_DT_TM",
          "CE_DYNAMIC_LABEL_ID"
        ],
        "role": "Stores every charted IView cell observation"
      },
      {
        "table": "CE_DYNAMIC_LABEL",
        "key_columns": [
          "CE_DYNAMIC_LABEL_ID",
          "LABEL_NAME",
          "LABEL_STATUS_CD",
          "CREATE_DT_TM"
        ],
        "role": "Groups multi-instance dynamic flowsheets (e.g., 'PIV #1 Left Forearm', 'Pressure Injury Sacrum')"
      }
    ],
    "payload_columns": [
      {
        "table_column": "CLINICAL_EVENT.RESULT_VAL",
        "ccl_type": "vc",
        "when_used": "Flowsheet cell value (numeric or text)"
      },
      {
        "table_column": "CLINICAL_EVENT.RESULT_UNITS_CD",
        "ccl_type": "f8 (CS 54)",
        "when_used": "Flowsheet measurement unit"
      },
      {
        "table_column": "CE_DYNAMIC_LABEL.LABEL_NAME",
        "ccl_type": "vc",
        "when_used": "Dynamic group instance label (wound/line/drain identifier)"
      }
    ],
    "join_pattern_sql": "ENCOUNTER e -> CLINICAL_EVENT ce (on ce.encntr_id = e.encntr_id and ce.valid_until_dt_tm >= 31-DEC-2100) LEFT JOIN CE_DYNAMIC_LABEL cdl (on cdl.ce_dynamic_label_id = ce.ce_dynamic_label_id)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Clinical Events",
      "fields": [
        "Enc Id",
        "CE Event",
        "CE Result Value",
        "CE Result Units",
        "CE Event End Dt Tm",
        "CE Result Status",
        "CE Valid Until Dt/Tm"
      ],
      "mandatory_filters": [
        "CE Valid Until Dt/Tm >= 12/31/2100 00:00:00",
        "CE Result Status = Auth (Verified)"
      ]
    }
  },
  {
    "id": "intake_and_output_2g",
    "name": "Intake & Output (I&O 2G Fluid Balance, Oral/IV Intake, Urine/Drain Output)",
    "keywords": [
      "intake",
      "output",
      "i&o",
      "fluid balance",
      "urine output",
      "emesis",
      "tube feeding",
      "iv fluid volume",
      "ce_intake_output_result"
    ],
    "definition_tables": [
      {
        "table": "V500_EVENT_CODE",
        "key_columns": [
          "EVENT_CD",
          "EVENT_CD_DISP",
          "EVENT_SET_NAME"
        ],
        "role": "Identifies the fluid/route reference event code (Code Set 72)"
      }
    ],
    "activity_tables": [
      {
        "table": "CE_INTAKE_OUTPUT_RESULT",
        "key_columns": [
          "CE_IO_RESULT_ID",
          "EVENT_ID",
          "ENCNTR_ID",
          "PERSON_ID",
          "IO_TYPE_FLAG",
          "IO_VOLUME",
          "IO_START_DT_TM",
          "IO_END_DT_TM",
          "REFERENCE_EVENT_CD",
          "VALID_UNTIL_DT_TM"
        ],
        "role": "Dedicated high-speed I&O volume table; IO_TYPE_FLAG: 1 = Intake, 2 = Output"
      }
    ],
    "payload_columns": [
      {
        "table_column": "CE_INTAKE_OUTPUT_RESULT.IO_VOLUME",
        "ccl_type": "f8",
        "when_used": "Measured fluid volume in milliliters (mL)"
      },
      {
        "table_column": "CE_INTAKE_OUTPUT_RESULT.IO_TYPE_FLAG",
        "ccl_type": "i4",
        "when_used": "1 = Intake, 2 = Output"
      },
      {
        "table_column": "CE_INTAKE_OUTPUT_RESULT.REFERENCE_EVENT_CD",
        "ccl_type": "f8 (CS 72)",
        "when_used": "Specific intake/output source (e.g., Foley Catheter, PO Fluid, IV Infused)"
      }
    ],
    "join_pattern_sql": "ENCOUNTER e -> CE_INTAKE_OUTPUT_RESULT cio (on cio.encntr_id = e.encntr_id and cio.valid_until_dt_tm >= 31-DEC-2100) -> CLINICAL_EVENT ce (on ce.event_id = cio.event_id and ce.valid_until_dt_tm >= 31-DEC-2100)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Clinical Events",
      "fields": [
        "Enc Id",
        "CE Event",
        "CE Result Value",
        "CE Result Units",
        "CE Event End Dt Tm",
        "CE Valid Until Dt/Tm"
      ],
      "mandatory_filters": [
        "CE Valid Until Dt/Tm >= 12/31/2100 00:00:00",
        "CE Result Status = Auth (Verified)"
      ]
    }
  },
  {
    "id": "dynamic_documentation_notes_blobs",
    "name": "Dynamic Documentation, PowerNotes, Discharge Summaries & Narrative Clinical Documents (SCD / CE_BLOB)",
    "keywords": [
      "note",
      "powernote",
      "dynamic documentation",
      "progress note",
      "discharge summary",
      "h&p",
      "history and physical",
      "consult note",
      "therapy note",
      "narrative",
      "blob",
      "ce_blob",
      "scd_story",
      "rtf",
      "html"
    ],
    "definition_tables": [
      {
        "table": "SCD_STORY",
        "key_columns": [
          "SCD_STORY_ID",
          "ENCNTR_ID",
          "PERSON_ID",
          "EVENT_ID",
          "TITLE",
          "STORY_TYPE_CD",
          "STORY_COMPLETION_STATUS_CD"
        ],
        "role": "Header table for structured PowerNotes and Dynamic Documentation stories"
      },
      {
        "table": "SCR_TERM",
        "key_columns": [
          "SCR_TERM_ID",
          "CONCEPT_CKI",
          "DISPLAY"
        ],
        "role": "Structured clinical documentation taxonomy terms"
      }
    ],
    "activity_tables": [
      {
        "table": "CLINICAL_EVENT",
        "key_columns": [
          "EVENT_ID",
          "PARENT_EVENT_ID",
          "ENCNTR_ID",
          "EVENT_CD",
          "EVENT_CLASS_CD",
          "EVENT_TITLE_TEXT",
          "PERFORMED_PRSNL_ID",
          "VERIFIED_DT_TM"
        ],
        "role": "Document header and section rows where EVENT_CLASS_CD (CS 53) in {'DOC', 'MDOC', 'ATTACHMENT'}"
      },
      {
        "table": "CE_BLOB_RESULT",
        "key_columns": [
          "EVENT_ID",
          "STORAGE_CD",
          "FORMAT_CD",
          "BLOB_HANDLE",
          "VALID_UNTIL_DT_TM"
        ],
        "role": "Document metadata specifying format (CS 23: RTF, HTML, XML, PDF, ASCII) and storage location"
      },
      {
        "table": "CE_BLOB",
        "key_columns": [
          "EVENT_ID",
          "BLOB_SEQ_NUM",
          "BLOB_CONTENTS",
          "BLOB_LENGTH",
          "COMPRESSION_CD",
          "VALID_UNTIL_DT_TM"
        ],
        "role": "Actual binary/text document body; if COMPRESSION_CD (CS 120) = OCFCOMP, decompress in CCL via uar_ocf_uncompress()"
      },
      {
        "table": "SCD_PARAGRAPH",
        "key_columns": [
          "SCD_PARAGRAPH_ID",
          "SCD_STORY_ID",
          "PARAGRAPH_CLASS_CD"
        ],
        "role": "Paragraphs within a structured PowerNote"
      },
      {
        "table": "SCD_SENTENCE",
        "key_columns": [
          "SCD_SENTENCE_ID",
          "SCD_PARAGRAPH_ID",
          "SCD_STORY_ID"
        ],
        "role": "Sentences within a structured PowerNote"
      },
      {
        "table": "SCD_TERM",
        "key_columns": [
          "SCD_TERM_ID",
          "SCD_SENTENCE_ID",
          "SCR_TERM_ID",
          "TRUTH_STATE_CD",
          "EVENT_ID"
        ],
        "role": "Discrete structured findings clicked inside a PowerNote"
      }
    ],
    "payload_columns": [
      {
        "table_column": "CE_BLOB.BLOB_CONTENTS",
        "ccl_type": "vc / raw blob",
        "when_used": "Full narrative note text (RTF/HTML/XHTML); decompress with uar_ocf_uncompress() when COMPRESSION_CD = OCFCOMP"
      },
      {
        "table_column": "CLINICAL_EVENT.EVENT_TITLE_TEXT",
        "ccl_type": "vc",
        "when_used": "Custom note title entered by the authoring provider"
      },
      {
        "table_column": "SCD_TERM.TRUTH_STATE_CD",
        "ccl_type": "f8",
        "when_used": "Present/Absent/Unknown state of a structured PowerNote term"
      }
    ],
    "join_pattern_sql": "ENCOUNTER e -> CLINICAL_EVENT ce_doc (on ce_doc.encntr_id = e.encntr_id and ce_doc.event_class_cd in (DOC, MDOC)) -> CE_BLOB_RESULT cbr (on cbr.event_id = ce_doc.event_id) -> CE_BLOB cb (on cb.event_id = cbr.event_id)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Clinical Events",
      "fields": [
        "Enc Id",
        "CE Event Id",
        "CE Event",
        "CE Event Title Text",
        "CE Performed Prsnl Name",
        "CE Verified Dt Tm",
        "CE Result Status",
        "CE Valid Until Dt/Tm"
      ],
      "mandatory_filters": [
        "CE Valid Until Dt/Tm >= 12/31/2100 00:00:00",
        "CE Result Status = Auth (Verified)"
      ]
    }
  },
  {
    "id": "order_entry_formats_and_details",
    "name": "Order Entry Format Forms (OE_FORMAT) & Captured Order Detail Prompts (ORDER_DETAIL)",
    "keywords": [
      "order form",
      "order detail",
      "oe_format",
      "order prompt",
      "indication",
      "isolation",
      "diet",
      "frequency",
      "route",
      "dose",
      "specimen",
      "consult reason",
      "order comment",
      "orders",
      "order_detail"
    ],
    "definition_tables": [
      {
        "table": "ORDER_CATALOG",
        "key_columns": [
          "CATALOG_CD",
          "PRIMARY_MNEMONIC",
          "CATALOG_TYPE_CD",
          "ACTIVITY_TYPE_CD",
          "OE_FORMAT_ID"
        ],
        "role": "Master catalog of orderable items (Code Set 200) and their assigned Order Entry Format"
      },
      {
        "table": "ORDER_ENTRY_FORMAT",
        "key_columns": [
          "OE_FORMAT_ID",
          "OE_FORMAT_NAME",
          "ACTION_TYPE_CD"
        ],
        "role": "Defines the order form layout presented when ordering (Code Set 6003 = ORDER)"
      },
      {
        "table": "OE_FORMAT_FIELDS",
        "key_columns": [
          "OE_FORMAT_ID",
          "OE_FIELD_ID",
          "LABEL_TEXT",
          "GROUP_SEQ",
          "FIELD_SEQ",
          "ACCEPT_FLAG"
        ],
        "role": "Specific prompt fields placed on an Order Entry Format"
      },
      {
        "table": "ORDER_ENTRY_FIELDS",
        "key_columns": [
          "OE_FIELD_ID",
          "DESCRIPTION",
          "FIELD_TYPE_FLAG",
          "CODESET",
          "OE_FIELD_MEANING_ID"
        ],
        "role": "Field definition and validation Code Set for an order prompt"
      }
    ],
    "activity_tables": [
      {
        "table": "ORDERS",
        "key_columns": [
          "ORDER_ID",
          "ENCNTR_ID",
          "PERSON_ID",
          "CATALOG_CD",
          "CATALOG_TYPE_CD",
          "ORDER_MNEMONIC",
          "ORDER_STATUS_CD",
          "ORIG_ORDER_DT_TM",
          "CLINICAL_DISPLAY_LINE"
        ],
        "role": "One row per placed order"
      },
      {
        "table": "ORDER_DETAIL",
        "key_columns": [
          "ORDER_ID",
          "ACTION_SEQUENCE",
          "DETAIL_SEQUENCE",
          "OE_FIELD_ID",
          "OE_FIELD_MEANING",
          "OE_FIELD_MEANING_ID",
          "OE_FIELD_DISPLAY_VALUE",
          "OE_FIELD_VALUE",
          "OE_FIELD_DT_TM_VALUE"
        ],
        "role": "Stores every discrete answer entered into the Order Entry Format prompts"
      },
      {
        "table": "ORDER_COMMENT",
        "key_columns": [
          "ORDER_ID",
          "ACTION_SEQUENCE",
          "COMMENT_TYPE_CD",
          "LONG_TEXT_ID"
        ],
        "role": "Links an order to free-text comments stored in LONG_TEXT"
      }
    ],
    "payload_columns": [
      {
        "table_column": "ORDER_DETAIL.OE_FIELD_DISPLAY_VALUE",
        "ccl_type": "vc",
        "when_used": "Human-readable answer to an order prompt (e.g., 'BID', 'PO', '10 mg', 'Contact Isolation', 'Eval and Treat')"
      },
      {
        "table_column": "ORDER_DETAIL.OE_FIELD_VALUE",
        "ccl_type": "f8",
        "when_used": "Numeric value or underlying CODE_VALUE of the order prompt answer"
      },
      {
        "table_column": "ORDER_DETAIL.OE_FIELD_DT_TM_VALUE",
        "ccl_type": "dq8",
        "when_used": "Date/time value answered on an order prompt (e.g., Requested Start Date/Time)"
      },
      {
        "table_column": "ORDERS.CLINICAL_DISPLAY_LINE",
        "ccl_type": "vc",
        "when_used": "Full formatted summary string of all Order Entry Format answers"
      },
      {
        "table_column": "LONG_TEXT.LONG_TEXT",
        "ccl_type": "vc",
        "when_used": "Order comment text joined via ORDER_COMMENT.LONG_TEXT_ID"
      }
    ],
    "join_pattern_sql": "ENCOUNTER e -> ORDERS o (on o.encntr_id = e.encntr_id and o.active_ind = 1) -> ORDER_DETAIL od (on od.order_id = o.order_id)",
    "da2_mapping": {
      "domain": "CWC Encounter",
      "sub_entity": "Orders",
      "fields": [
        "Enc Id",
        "Ord Order Id",
        "Ord Mnemonic",
        "Ord Detail Display",
        "Ord Status",
        "Ord Orig Order Dt/Tm"
      ],
      "mandatory_filters": [
        "Enc Active Ind = 1"
      ]
    }
  },
